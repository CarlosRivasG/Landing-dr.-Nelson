{
  "name": "@odontologia/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "test:integration": "tsc -p tsconfig.test.json && node --test dist-test/test/integration/*.test.js",
    "migration:show": "pnpm build && typeorm migration:show -d dist/database/data-source.js",
    "migration:run": "pnpm build && typeorm migration:run -d dist/database/data-source.js",
    "migration:revert": "pnpm build && typeorm migration:revert -d dist/database/data-source.js",
    "migration:create": "typeorm migration:create",
    "migration:generate": "pnpm build && typeorm migration:generate -d dist/database/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/typeorm": "12.0.2",
    "dotenv": "18.0.8",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@types/pg": "8.23.1",
    "tsc-watch": "7.2.1"
  }
}
